{
  "name": "form-driven-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "表单驱动的多 Agent 研发流水线：钉钉/飞书收集单 → 需求评估 → 开发 → 测试部署 → 产品验收 → 生产部署",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm -r test",
    "typecheck": "corepack pnpm -r typecheck",
    "gateway": "corepack pnpm --filter @pipeline/gateway start",
    "simulate": "node scripts/simulate-submit.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
