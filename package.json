{
  "name": "agent-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "agent-pipeline：多 Agent 研发交付流水线（需求触发 → 评估 → 开发 → 测试 → 部署 → 验收 → 生产，流程可定制编排、支持多开发 Agent 联调）",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm -r test",
    "typecheck": "corepack pnpm -r typecheck",
    "gateway": "corepack pnpm --filter @pipeline/gateway start",
    "simulate": "node scripts/simulate-submit.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
