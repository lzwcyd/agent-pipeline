# ── 服务 ─────────────────────────────────────────────────────────────────────
PORT=3081
# 流水线数据目录（相对仓库根）
PIPELINE_DATA_DIR=data

# ── DSH Agent 运行时 ──────────────────────────────────────────────────────────
# 调用 DSH headless agent 的可执行文件。默认 `dsh`（需在 PATH 中）。
# 本机 npx 缓存示例：
# DSH_CLI=/Users/<you>/.npm/_npx/<hash>/node_modules/.bin/dsh
DSH_CLI=dsh
# DSH headless 单次运行超时（毫秒）
DSH_AGENT_TIMEOUT_MS=600000

# ── 流水线开关 ────────────────────────────────────────────────────────────────
# 测试部署验收通过后是否自动进入生产部署（false 时需人工调用 accept 接口）
AUTO_ACCEPT=true
# 流水线模式：simulation（开发/部署均为模拟产出，验收按完整性核对）| real（真实交付，严格验收）
PIPELINE_MODE=simulation
# 验收失败时的默认处理：rollback（回滚测试环境后打回开发）| rework（直接打回开发）| reject（直接终止）。
# 可被触发级 policy 覆盖（表单字段 _policy 或 API 触发 policy 字段）
ACCEPTANCE_FAILURE_POLICY=rollback
# 测试/验收未通过时打回开发的最大次数，超限终止流水线
MAX_REWORK=3
# 流程模板 JSON 路径（相对仓库根；缺省内置 default）
# 示例：config/pipelines/with-code-review.json（加评审节点）、config/pipelines/multi-dev.json（多开发 Agent 联调）
# PIPELINE_TEMPLATE=
# 日志级别：trace|debug|info|warn|error
LOG_LEVEL=info
# 运维 Agent 无 kubectl 时的部署模式：simulated | kubectl
OPS_MODE=auto

# ── 通知（至少留 console）──────────────────────────────────────────────────────
NOTIFY_CHANNELS=console
# 飞书自定义机器人（可选）
# NOTIFY_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# NOTIFY_FEISHU_SECRET=xxx
# 钉钉自定义机器人（可选）
# NOTIFY_DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
# NOTIFY_DINGTALK_SECRET=xxx

# ── 飞书事件订阅（无凭证时留空，仅走 Mock/直连模式）──────────────────────────────
# FEISHU_ENCRYPT_KEY=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# ── 钉钉事件订阅 ────────────────────────────────────────────────────────────────
# DINGTALK_APP_KEY=
# DINGTALK_APP_SECRET=
